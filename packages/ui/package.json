{
  "name": "@pavilion/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @pavilion/engine build && pnpm --filter @pavilion/world build && pnpm --filter @pavilion/career build && pnpm --filter @pavilion/narrative build && pnpm --filter @pavilion/presentation build",
    "dev": "vite",
    "prebuild": "pnpm --filter @pavilion/engine build && pnpm --filter @pavilion/world build && pnpm --filter @pavilion/career build && pnpm --filter @pavilion/narrative build && pnpm --filter @pavilion/presentation build",
    "build": "vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@pavilion/career": "workspace:*",
    "@pavilion/data": "workspace:*",
    "@pavilion/engine": "workspace:*",
    "@pavilion/narrative": "workspace:*",
    "@pavilion/presentation": "workspace:*",
    "@pavilion/world": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
